{
    "attribution": false,
    "autoMemoryEnabled": false,
    "disableArtifact": true,
    "disableBundledSkills": true,
    "disableClaudeAiConnectors": true,
    "disableWorkflows": true,
    "enabledPlugins": {
        "better-tool-rows@akilin-plugins": true,
        "plugin-authoring@builtin": false,
        "prompt-bubbles@akilin-plugins": true
    },
    "extraKnownMarketplaces": {
        "akilin-plugins": {
            "source": {
                "source": "github",
                "repo": "akilin/claude-plugins"
            },
            "autoUpdate": true
        }
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh ~/.claude/bell.sh"
                    }
                ]
            }
        ]
    },
    "modelSettings": {
        "claude-opus-5-5": {
            "effortLevel": "high"
        },
        "claude-sonnet-5-5": {
            "effortLevel": "high"
        }
    },
    "permissions": {
        "deny": [
            "CronCreate",
            "CronDelete",
            "CronList",
            "DesignSync",
            "EnterPlanMode",
            "EnterWorktree",
            "ExitPlanMode",
            "ExitWorktree",
            "NotebookEdit",
            "PushNotification",
            "RemoteTrigger",
            "ReportFindings",
            "ScheduleWakeup",
            "SendFeedback"
        ]
    },
    "promptSuggestionEnabled": false,
    "skillOverrides": {
        "anthropic-skills:docs": "off",
        "anthropic-skills:docx": "off",
        "anthropic-skills:google-workspace": "off",
        "anthropic-skills:import-memory": "off",
        "anthropic-skills:morning": "off",
        "anthropic-skills:pdf": "off",
        "anthropic-skills:pptx": "off",
        "anthropic-skills:skill-creator": "off",
        "anthropic-skills:xlsx": "off"
    },
    "spinnerTipsEnabled": false,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Working"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "bash ~/.claude/statusline-command.sh"
    },
    "theme": "dark",
    "timeFormat": "24-hour",
    "timeZone": "Europe/Kyiv",
    "worktree": {
        "bgIsolation": "none"
    }
}
