{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+l": "command:clear"
      }
    },
    {
      "context": "Select",
      "bindings": {
        "w": "select:previous",
        "s": "select:next"
      }
    },
    {
      "context": "Tabs",
      "bindings": {
        "a": "tabs:previous",
        "d": "tabs:next"
      }
    }
  ]
}
